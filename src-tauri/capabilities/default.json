{
  "$schema": "https://schema.tauri.app/capability/2.0.0",
  "identifier": "default",
  "description": "Default permissions for the webgen-motion main window — scoped to the shell plugin so the Rust shell can spawn the bundled Node + ffmpeg sidecars at runtime.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node",
          "sidecar": true,
          "args": true
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "ffprobe",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
