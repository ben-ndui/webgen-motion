# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# license keypairs (private key MUST stay offline / never commit)
# Public key embed va dans src/lib/license/public-key.ts manuellement.
/keys/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.idea/

# tauri (Rust target / bundled DMGs / EXEs / lockfile)
/src-tauri/target/
/src-tauri/gen/
# Staged Next.js standalone + runners + frontendDist placeholder
# (rebuilt every `tauri build` by scripts/desktop-prepare-standalone.mjs)
/src-tauri/standalone/
/src-tauri/runners/
/src-tauri/dist/
# Sidecar binaries (Node + ffmpeg per platform triple, ~190 MB / host).
# Fetched fresh on each machine via `node scripts/desktop-fetch-binaries.mjs`
# and rebuilt in CI for cross-platform releases.
/src-tauri/binaries/
issued/
claude-code-audit-prompt.md
